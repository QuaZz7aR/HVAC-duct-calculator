      "Bash(npm audit fix *)",
      "Bash(npm in)",
      "Bash(npm in *)",
      "Bash(npm ins)",
      "Bash(npm ins *)",
      "Bash(npm it)",
      "Bash(npm it *)",
      "Bash(npm install-test)",
      "Bash(npm install-test *)",
      "Bash(npm rm)",
      "Bash(npm rm *)",
      "Bash(npm un)",
      "Bash(npm un *)",
      "Bash(npm dedupe)",
      "Bash(npm dedupe *)",
      "Bash(npm ddp)",
      "Bash(npm ddp *)",
      "Bash(npm prune)",
      "Bash(npm prune *)",
      "Bash(npm link)",
