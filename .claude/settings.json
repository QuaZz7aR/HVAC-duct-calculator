      "Bash(pnpm install)",
      "Bash(pnpm install *)",
      "Bash(pnpm add)",
      "Bash(pnpm add *)",
      "Bash(pnpm up)",
      "Bash(pnpm up *)",
      "Bash(pnpm upgrade)",
      "Bash(pnpm upgrade *)",
      "Bash(pnpm remove)",
      "Bash(pnpm remove *)",
      "Bash(yarn install)",
      "Bash(yarn install *)",
      "Bash(yarn add)",
      "Bash(yarn add *)",
      "Bash(yarn up)",
