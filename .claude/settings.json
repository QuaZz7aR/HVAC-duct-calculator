  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              ".claude/hooks/stop-check.mjs"
            ],
            "timeout": 600,
            "statusMessage": "Running typecheck, lint and tests..."
          }
        ]
      }
    ]
  }
