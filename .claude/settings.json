      "Bash(npm add)",
      "Bash(npm add *)",
      "Bash(npm update)",
      "Bash(npm update *)",
      "Bash(npm up)",
      "Bash(npm up *)",
      "Bash(npm upgrade)",
      "Bash(npm upgrade *)",
